views:
  - type: table
    name: 灵感库
    filters:
      and:
        - file.inFolder("灵感库")
    groupBy:
      property: created
      direction: DESC
    order:
      - file.name
      - status
      - scope
      - related
      - created
    sort:
      - property: status
        direction: DESC
      - property: related
        direction: DESC
    cardSize: 80
    imageFit: contain
    image: note.name
    columnSize:
      file.name: 339
      note.status: 120
      note.scope: 120
